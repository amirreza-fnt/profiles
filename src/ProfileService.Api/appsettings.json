{
  "ConnectionStrings": {
    "Profile": "Server=127.0.0.1,1433;Database=apiweb-profilesystem;User Id=sa;Password=ChangeMe;Encrypt=True;TrustServerCertificate=True;Connection Timeout=15;Connect Retry Count=3;Pooling=true;Max Pool Size=100;MultipleActiveResultSets=true"
  },
  "Sso": {
    "BaseUrl": "http://127.0.0.1:5001",
    "UserInfoPath": "/api/auth/me",
    "TimeoutSeconds": 8,
    "RetryCount": 2,
    "CircuitBreakerMinThroughput": 5,
    "CircuitBreakerFailureRatio": 50
  },
  "InternalAuth": {
    "HeaderName": "X-Api-Key",
    "ApiKeys": [
      {
        "Key": "dev-internal-key-profile",
        "Name": "SsoLoginService"
      },
      {
        "Key": "dev-internal-key-137",
        "Name": "InternalDev"
      }
    ]
  },
  "Verification": {
    "CodeLength": 6,
    "ExpirationMinutes": 5,
    "MaxAttempts": 5,
    "ShowCodeInResponse": true,
    "Provider": "Console"
  },
  "FileStorage": {
    "BaseUrl": "https://storage.sabzevar.ir"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://apiweb-profilesystem.sabzevar.ir",
      "http://localhost:3000"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "Logging": {
    "File": "/var/log/profileservice/app-.log",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5027"
      }
    }
  }
}
